# Phiversity configuration.
# Copy to .env and fill in. Any OpenAI-compatible endpoint works:
#   OpenAI:    https://api.openai.com/v1
#   NVIDIA:    https://integrate.api.nvidia.com/v1
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://localhost:8000/v1

# LLM_PROVIDER: openai (any OpenAI-compatible endpoint) | anthropic
PHIVERSITY_PROVIDER=openai

# API key for your provider (OPENAI_API_KEY / NVIDIA_API_KEY also work)
LLM_API_KEY=

# Base URL of the chat-completions endpoint (OPENAI_BASE_URL also works)
LLM_BASE_URL=https://api.openai.com/v1

# Model name as known by your provider (LLM_MODEL / OPENAI_MODEL also work)
LLM_MODEL=gpt-4o-mini

# Default TTS voice (Microsoft neural voice for edge-tts)
PHIVERSITY_VOICE=en-US-AriaNeural

# ---------------------------------------------------------------------------
# Cloud deployment (see DEPLOYMENT.md). Everything below is optional for
# local use; the backend falls back to SQLite + local disk when unset.
# ---------------------------------------------------------------------------

# Supabase Postgres storage (jobs, chats, lectures, videos, users)
SUPABASE_URL=
# Service-role key: SERVER-SIDE ONLY. Never ship this to a browser.
SUPABASE_SERVICE_KEY=
# Anon key: safe for the frontend; the backend uses it to verify
# Supabase Auth bearer tokens.
SUPABASE_ANON_KEY=

# Cloudinary video storage (finished mp4s; the local copy is a cache)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# API secret: SERVER-SIDE ONLY.
CLOUDINARY_API_SECRET=

# CORS allowlist for the API: comma-separated origins, or * for any.
ALLOWED_ORIGINS=*

# 1 = render inside the API process (single free service).
# 0 = API only; run `phiversity-worker` separately.
PHIVERSITY_INLINE_WORKER=1

